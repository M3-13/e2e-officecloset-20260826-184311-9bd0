{
  "runcontract": 1,
  "services": [
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [["npm", "ci"]],
      "build": [["npm", "run", "build"]],
      "start": ["node", "node_modules/vite/bin/vite.js", "--host", "127.0.0.1", "--port", "${PORT}"],
      "port": 5173,
      "health": { "path": "/", "expect_status": [200] }
    }
  ]
}
